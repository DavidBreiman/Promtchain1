1497 ' \u1497 \u1499 \u1493 \u1500  \u1500 \u1492 \u1514 \u1492 \u1493 \u1493 \u1514  \u1506 \u1493 \u1500 \u1502 \u1493 \u1514  \u1488 \u1497 \u1503  \u1511 \u1509 , \u1493 \u1490 \u1501  \u1492 \u1497 ' \u1497 \u1499 \u1493 \u1500  \u1500 \u1497 \u1488 \u1510 \u1500  \u1493 \u1500 \u1492 \u1502 \u1513 \u1497 \u1498  \u1512 \u1489 \u1493 \u1488  \u1512 \u1489 \u1489 \u1493 \u1514  \u1505 \u1508 \u1497 \u1512 \u1493 \u1514  \u1506 \u1491  \u1488 \u1497 \u1503  \u1511 \u1509  (\u1506 \u1499 "\u1500 ). \u1493 \u1492 \u1506 \u1504 \u1497 \u1503  \u1489 \u1494 \u1492 , \u1491 \u1492 \u1504 \u1492 , \u1502 \u1492  \u1513 \u1504 \u1511 \u1512 \u1488  \u1489 \u1513 \u1501  \u1488 \u1493 \u1512 , \u1492 \u1512 \u1497  \u1494 \u1492  \u1500 \u1492 \u1493 \u1512 \u1493 \u1514  \u1513 \u1488 \u1497 \u1504 \u1493  \u1492 \u1502 \u1488 \u1493 \u1512 , \u1499 \u1497  \u1488 \u1501  \u1488 \u1493 \u1512 , \u1513 \u1506 \u1504 \u1497 \u1504 \u1493  \u1492 \u1493 \u1488  \'96 \u1499 \u1513 \u1502 \u1493  \'96 \u1492 \u1488 \u1512 \u1492  \u1489 \u1500 \u1489 \u1491 . \u1493 \u1500 \u1499 \u1503 , \u1502 \u1510 \u1491  \u1506 \u1504 \u1497 \u1503  \u1492 \u1502 \u1488 \u1493 \u1512  (\u1513 \u1513 \u1501  \u1492 \u1493 \u1488  \u1488 \u1502 \u1497 \u1514 \u1497 \u1514  \u1506 \u1504 \u1497 \u1503  \u1492 \u1497 \u1499 \u1493 \u1500 \u1514 ) \u1500 \u1488  \u1513 \u1497 \u1497 \u1498  \u1500 \u1493 \u1502 \u1512  \u1500 \u1502 \u1506 \u1500 \u1492  \u1502 \u1506 \u1500 \u1492  \u1493 \u1500 \u1502 \u1496 \u1492  \u1502 \u1496 \u1492 , \u1493 \u1492 \u1497 \u1497 \u1504 \u1493 , \u1513 \u1492 \u1493 \u1488  \u1512 \u1511  \u1504 \u1493 \u1513 \u1488  \u1506 \u1504 \u1497 \u1504 \u1497 \u1501  \u1488 \u1500 \u1493 , \u1488 \u1489 \u1500  \u1500 \u1488  \u1513 \u1497 \u1497 \u1498  \u1500 \u1493 \u1502 \u1512  \u1513 \u1497 \u1513 \u1504 \u1501  \u1489 ' \u1502 \u1491 \u1512 \u1497 \u1490 \u1493 \u1514 , \u1493 \u1506 \u1488 \u1499 \u1493 "\u1499  \u1513 \u1500 \u1488  \u1513 \u1497 \u14